# ============================================
# SageAI — Production Environment Template
# 1. Copy this file to `.env` on your VPS
# 2. Fill in all the actual values
# 3. DO NOT commit `.env` to Git
# ============================================

# ── General ──
# The base domain name (e.g., sageai.com) without https://
DOMAIN=example.com

# ── Database ──
# Create a strong, random password for the Postgres database
POSTGRES_PASSWORD=generate_a_very_strong_password_here

# ── Security Keys ──
# Must be at least 32 random characters (e.g., generate with `openssl rand -hex 32`)
SECRET_KEY=generate_a_very_strong_secret_key_here
INTERNAL_SERVICE_KEY=generate_a_very_strong_service_key_here

# ── Stripe (Live Mode) ──
# Get these from your Stripe Dashboard (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
STRIPE_PRO_PRICE_ID=price_YOUR_LIVE_PRICE_ID
STRIPE_STARTER_PRICE_ID=price_YOUR_LIVE_STARTER_ID
STRIPE_ENTERPRISE_PRICE_ID=price_YOUR_LIVE_ENTERPRISE_ID

# ── AI APIs ──
NVIDIA_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── OSINT APIs (Optional depending on usage) ──
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
