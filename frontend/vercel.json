            "destination": "https://sageai-api.onrender.com/scan/:path*"
        },
        {
            "source": "/scans/:path*",
            "destination": "https://sageai-api.onrender.com/scans/:path*"
        },
        {
            "source": "/reports/:path*",
            "destination": "https://sageai-api.onrender.com/reports/:path*"
        },
        {
            "source": "/explain/:path*",
            "destination": "https://sageai-api.onrender.com/explain/:path*"
        },
        {
            "source": "/org/:path*",
            "destination": "https://sageai-api.onrender.com/org/:path*"
        },
        {
            "source": "/api-keys/:path*",
            "destination": "https://sageai-api.onrender.com/api-keys/:path*"
        },
        {
            "source": "/webhooks/:path*",
            "destination": "https://sageai-api.onrender.com/webhooks/:path*"
        },
        {
            "source": "/billing/:path*",
            "destination": "https://sageai-api.onrender.com/billing/:path*"
        },
        {
            "source": "/schedules/:path*",
            "destination": "https://sageai-api.onrender.com/schedules/:path*"
        },
        {
            "source": "/ai/:path*",
            "destination": "https://sageai-api.onrender.com/ai/:path*"
        },
        {
            "source": "/assets/:path*",
            "destination": "https://sageai-api.onrender.com/assets/:path*"
        },
        {
            "source": "/agents/:path*",
            "destination": "https://sageai-api.onrender.com/agents/:path*"
        },
        {
            "source": "/autofix/:path*",
            "destination": "https://sageai-api.onrender.com/autofix/:path*"
        },
        {
            "source": "/integrations/:path*",
            "destination": "https://sageai-api.onrender.com/integrations/:path*"
        },
        {
            "source": "/metrics",
            "destination": "https://sageai-api.onrender.com/metrics"
