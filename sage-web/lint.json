leErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useState, useEffect } from \"react\";\nimport { Github, Loader2, Key, CheckCircle2, XCircle } from \"lucide-react\";\nimport axios from \"axios\";\n\nexport function IntegrationManager() {\n  const [loading, setLoading] = useState(true);\n  const [status, setStatus] = useState<{ is_connected: boolean }>({ is_connected: false });\n  const [pat, setPat] = useState(\"\");\n  const [saving, setSaving] = useState(false);\n  const [message, setMessage] = useState(\"\");\n  const [error, setError] = useState(\"\");\n\n  const fetchStatus = async () => {\n    try {\n      const { data } = await axios.get(\"/api/integrations/github\");\n      setStatus(data);\n    } catch {\n      setError(\"Failed to fetch Github integration status\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchStatus();\n  }, []);\n\n  const handleConnect = async () => {\n    if (!pat) return;\n    setSaving(true);\n    setError(\"\");\n    setMessage(\"\");\n    try {\n      await axios.post(\"/api/integrations/github\", { pat });\n      setStatus({ is_connected: true });\n      setMessage(\"GitHub connected successfully. Auto-Fix can now create PRs.\");\n      setPat(\"\");\n    } catch {\n      setError(\"Failed to connect GitHub. Please verify your PAT has 'repo' scope.\");\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const handleDisconnect = async () => {\n    setSaving(true);\n    setError(\"\");\n    setMessage(\"\");\n    try {\n      await axios.delete(\"/api/integrations/github\");\n      setStatus({ is_connected: false });\n      setMessage(\"GitHub disconnected. Auto-Fix PRs are disabled.\");\n    } catch {\n      setError(\"Failed to disconnect GitHub\");\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  if (loading) return <div className=\"animate-pulse h-32 bg-zinc-900/50 rounded-xl\" />;\n\n  return (\n    <div className=\"bg-zinc-900/60 border border-emerald-900/30 rounded-xl p-6\">\n      <div className=\"flex items-center justify-between mb-6\">\n        <h3 className=\"text-sm font-bold text-white flex items-center gap-2\">\n          <Github className=\"w-5 h-5 text-zinc-400\" />\n          GitHub Integration\n        </h3>\n        {status.is_connected ? (\n          <span className=\"flex items-center gap-1.5 text-xs font-medium text-emerald-400 bg-emerald-400/10 px-2 py-1 rounded-full border border-emerald-400/20\">\n            <CheckCircle2 className=\"w-3.5 h-3.5\" /> Connected\n          </span>\n        ) : (\n          <span className=\"flex items-center gap-1.5 text-xs font-medium text-zinc-400 bg-zinc-800 px-2 py-1 rounded-full border border-zinc-700\">\n            <XCircle className=\"w-3.5 h-3.5\" /> Not Connected\n          </span>\n        )}\n      </div>\n\n      <p className=\"text-sm text-zinc-400 mb-6\">\n        Connect your GitHub account using a Personal Access Token (PAT) to enable SageAI's Auto-Fix engine to directly open Pull Requests with vulnerability patches.\n      </p>\n\n      {!status.is_connected ? (\n        <div className=\"space-y-4\">\n          <div>\n            <label className=\"block text-xs font-medium text-zinc-400 mb-1\">Personal Access Token</label>\n            <div className=\"flex gap-3\">\n              <input \n                type=\"password\" \n                value={pat} \n                onChange={e => setPat(e.target.value)}\n                placeholder=\"ghp_xxxxxxxxxxxx\"\n                className=\"flex-1 bg-black/50 border border-zinc-700 rounded-lg px-4 py-2 text-white font-mono text-sm placeholder:text-zinc-600 focus:outline-none focus:border-emerald-500 transition-colors\"\n               />\n              <button \n                onClick={handleConnect} \n                disabled={saving || !pat}\n                className=\"bg-emerald-600 hover:bg-emerald-500 disabled:bg-zinc-700 text-white font-bold px-5 py-2 rounded-lg transition-colors text-sm flex items-center gap-2\"\n              >\n                {saving ? <Loader2 className=\"w-4 h-4 animate-spin\" /> : <Key className=\"w-4 h-4\" />}\n                Connect\n              </button>\n            </div>\n          </div>\n          <p className=\"text-xs text-zinc-500\">Requires a token with <code className=\"text-emerald-400 bg-emerald-400/10 px-1 rounded\">repo</code> scope.</p>\n        </div>\n      ) : (\n        <div>\n          <button \n            onClick={handleDisconnect} \n            disabled={saving}\n            className=\"bg-red-600/20 hover:bg-red-500/30 text-red-500 hover:text-red-400 border border-red-500/30 hover:border-red-500/50 disabled:opacity-50 font-bold px-5 py-2 rounded-lg transition-colors text-sm\"\n          >\n            {saving ? \"Disconnecting...\" : \"Disconnect GitHub\"}\n          </button>\n        </div>\n      )}\n\n      {error && <p className=\"text-sm text-red-400 mt-4\">{error}</p>}\n      {message && <p className=\"text-sm text-emerald-400 mt-4\">{message}</p>}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\IntelligenceHub.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\LandingPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\MFASettings.tsx","messages":[{"ruleId":"@next/next/no-img-element","severity":1,"message":"Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` or a custom image loader to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","line":92,"column":13,"nodeType":"JSXOpeningElement","endLine":92,"endColumn":111}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useState } from \"react\";\nimport { ShieldCheck, Loader2, Key } from \"lucide-react\";\nimport axios from \"axios\";\n\ninterface MFASetup {\n  secret: string;\n  qr_code: string;\n  backup_codes: string[];\n}\n\nexport function MFASettings() {\n  const [setupData, setSetupData] = useState<MFASetup | null>(null);\n  const [code, setCode] = useState(\"\");\n  const [loading, setLoading] = useState(false);\n  const [mfaEnabled, setMfaEnabled] = useState(false);\n  const [error, setError] = useState(\"\");\n  const [message, setMessage] = useState(\"\");\n\n  const handleSetup = async () => {\n    setLoading(true);\n    setError(\"\");\n    try {\n      const { data } = await axios.post(\"/api/mfa?action=setup\");\n      setSetupData(data);\n    } catch {\n      setError(\"Failed to initiate MFA setup.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleVerify = async () => {\n    setLoading(true);\n    setError(\"\");\n    try {\n      await axios.post(\"/api/mfa?action=verify\", { code });\n      setMfaEnabled(true);\n      setSetupData(null);\n      setMessage(\"MFA activated successfully.\");\n      setCode(\"\");\n    } catch {\n      setError(\"Invalid code. Please try again.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleDisable = async () => {\n    if (!code) {\n      setError(\"Enter a TOTP code to disable MFA.\");\n      return;\n    }\n    setLoading(true);\n    setError(\"\");\n    try {\n      await axios.post(\"/api/mfa?action=disable\", { code });\n      setMfaEnabled(false);\n      setMessage(\"MFA has been disabled.\");\n      setCode(\"\");\n    } catch {\n      setError(\"Invalid code. Please try again.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"bg-zinc-900/60 border border-emerald-900/30 rounded-xl p-6\">\n      <h3 className=\"text-sm font-bold text-emerald-400 flex items-center gap-2 mb-4\">\n        <ShieldCheck className=\"w-4 h-4\" /> Multi-Factor Authentication\n      </h3>\n\n      {!mfaEnabled && !setupData && (\n        <div className=\"space-y-4\">\n          <p className=\"text-sm text-zinc-400\">\n            Secure your account with 2FA. You will need an authenticator app (e.g., Google Authenticator, Authy).\n          </p>\n          <button onClick={handleSetup} disabled={loading}\n            className=\"bg-emerald-600 hover:bg-emerald-500 disabled:bg-zinc-700 text-white font-bold px-5 py-2 rounded-lg transition-colors text-sm flex items-center gap-2\">\n            {loading ? <Loader2 className=\"w-4 h-4 animate-spin\" /> : <Key className=\"w-4 h-4\" />} Enable MFA\n          </button>\n        </div>\n      )}\n\n      {setupData && !mfaEnabled && (\n        <div className=\"space-y-4\">\n          <p className=\"text-sm text-zinc-400\">1. Scan this QR code with your authenticator app:</p>\n          <div className=\"bg-white p-2 w-fit rounded-lg shadow-sm\">\n            {/* The qr_code from backend is an SVG or base64 data URI */}\n            <img src={`data:image/png;base64,${setupData.qr_code}`} alt=\"MFA QR Code\" className=\"w-40 h-40\" />\n          </div>\n\n          <p className=\"text-sm text-zinc-400\">2. Save these backup codes in a secure place:</p>\n          <div className=\"bg-black/50 border border-amber-900/50 rounded-lg p-3\">\n            <code className=\"text-amber-400 font-mono text-xs whitespace-pre-wrap leading-relaxed tracking-widest\">\n              {setupData.backup_codes.join(\"   \")}\n            </code>\n          </div>\n\n          <p className=\"text-sm text-zinc-400\">3. Enter the 6-digit code from your app to verify setup:</p>\n          <div className=\"flex gap-3 max-w-sm\">\n            <input type=\"text\" value={code} onChange={e => setCode(e.target.value)} placeholder=\"000000\"\n              className=\"flex-1 bg-black/50 border border-zinc-700 rounded-lg px-4 py-2 text-white font-mono text-sm tracking-widest placeholder:text-zinc-600 focus:outline-none focus:border-emerald-500 transition-colors\" />\n            <button onClick={handleVerify} disabled={loading || code.length < 6}\n              className=\"bg-emerald-600 hover:bg-emerald-500 disabled:bg-zinc-700 text-white font-bold px-5 py-2 rounded-lg transition-colors text-sm\">\n              {loading ? \"Verifying...\" : \"Verify\"}\n            </button>\n          </div>\n        </div>\n      )}\n\n      {mfaEnabled && (\n        <div className=\"space-y-4\">\n          <div className=\"bg-emerald-900/20 border border-emerald-800/40 rounded-lg p-3 flex items-center gap-3\">\n            <ShieldCheck className=\"w-5 h-5 text-emerald-400\" />\n            <p className=\"text-sm text-emerald-400 font-bold\">MFA is active</p>\n          </div>\n          <p className=\"text-sm text-zinc-400\">Enter a code from your authenticator app to disable MFA.</p>\n          <div className=\"flex gap-3 max-w-sm\">\n            <input type=\"text\" value={code} onChange={e => setCode(e.target.value)} placeholder=\"000000\"\n              className=\"flex-1 bg-black/50 border border-zinc-700 rounded-lg px-4 py-2 text-white font-mono text-sm tracking-widest placeholder:text-zinc-600 focus:outline-none focus:border-red-500 transition-colors\" />\n            <button onClick={handleDisable} disabled={loading || code.length < 6}\n              className=\"bg-red-600/80 hover:bg-red-500 disabled:bg-zinc-700 text-white font-bold px-5 py-2 rounded-lg transition-colors text-sm\">\n              {loading ? \"Disabling...\" : \"Disable\"}\n            </button>\n          </div>\n        </div>\n      )}\n\n      {error && <p className=\"text-sm text-red-400 mt-4\">{error}</p>}\n      {message && <p className=\"text-sm text-emerald-400 mt-4\">{message}</p>}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\MobileNav.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\NavNotifications.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\NotificationBell.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\OnboardingWizard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\OrgSettings.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\RBACMatrix.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\RedTeamPanel.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\ReportView.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\RiskGauge.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\ScanInput.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\ScheduleManager.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\SecuritySettings.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\ShareButton.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Copy' is defined but never used.","line":3,"column":25,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":29,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Copy"},"fix":{"range":[37,43],"text":""},"desc":"Remove unused variable \"Copy\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { Share2, Check, Copy } from \"lucide-react\";\nimport { useState } from \"react\";\n\ninterface ShareButtonProps {\n  scanId: string;\n}\n\nexport function ShareButton({ scanId }: ShareButtonProps) {\n  const [loading, setLoading] = useState(false);\n  const [copied, setCopied] = useState(false);\n\n  const handleShare = async () => {\n    setLoading(true);\n    try {\n      const res = await fetch(`/api/scan/${scanId}/share`, { method: \"POST\" });\n      if (!res.ok) throw new Error(\"Share link generation failed\");\n\n      const { share_token } = await res.json();\n      const shareUrl = `${window.location.origin}/report/${share_token}`;\n      \n      await navigator.clipboard.writeText(shareUrl);\n      setCopied(true);\n      setTimeout(() => setCopied(false), 3000);\n    } catch (e) {\n      console.error(\"Share failed\", e);\n      alert(\"Failed to generate share link. Please try again.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <button\n      onClick={handleShare}\n      disabled={loading}\n      className={`group flex items-center gap-2 px-6 py-3 rounded-lg font-mono font-bold text-sm border transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed\n        ${copied \n          ? \"bg-emerald-500 text-black border-emerald-500 shadow-[0_0_20px_rgba(16,185,129,0.4)]\" \n          : \"bg-emerald-900/30 border-emerald-500/40 text-emerald-400 hover:bg-emerald-800/40 hover:border-emerald-400/60 hover:shadow-[0_0_20px_rgba(16,185,129,0.2)]\"\n        }`}\n    >\n      {copied ? (\n        <>\n          <Check className=\"w-4 h-4\" />\n          Link Copied!\n        </>\n      ) : (\n        <>\n          <Share2 className={`w-4 h-4 ${loading ? \"animate-spin\" : \"group-hover:-translate-y-0.5\"} transition-transform`} />\n          {loading ? \"Generating...\" : \"Share Report\"}\n        </>\n      )}\n    </button>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\SystemHealth.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecat