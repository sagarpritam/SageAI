n  severity: string;\n  title: string;\n  description?: string;\n  created_at?: string;\n}\n\nconst sevConfig: Record<string, { color: string; icon: typeof AlertCircle }> = {\n  critical: { color: \"border-red-500 bg-red-950/40 text-red-400\", icon: AlertCircle },\n  high: { color: \"border-orange-500 bg-orange-950/40 text-orange-400\", icon: AlertTriangle },\n  medium: { color: \"border-amber-500 bg-amber-950/40 text-amber-400\", icon: AlertTriangle },\n  low: { color: \"border-blue-500 bg-blue-950/40 text-blue-400\", icon: Info },\n  info: { color: \"border-zinc-600 bg-zinc-900/40 text-zinc-400\", icon: Info },\n};\n\nexport function ASMTimeline() {\n  const [events, setEvents] = useState<ASMEvent[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  const fetchEvents = useCallback(() => {\n    setLoading(true);\n    axios\n      .get(\"/api/asm\")\n      .then((r) => setEvents(Array.isArray(r.data) ? r.data : []))\n      .catch(() => setEvents([]))\n      .finally(() => setLoading(false));\n  }, []);\n\n  useEffect(() => {\n    fetchEvents();\n    const interval = setInterval(fetchEvents, 30000); // auto-refresh every 30s\n    return () => clearInterval(interval);\n  }, [fetchEvents]);\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex items-center justify-between\">\n        <h3 className=\"text-sm font-bold text-zinc-400 flex items-center gap-2\">\n          <Activity className=\"w-4 h-4 text-emerald-400\" /> Attack Surface Events\n        </h3>\n        <span className=\"text-xs text-zinc-600 font-mono\">Auto-refreshes every 30s</span>\n      </div>\n\n      {loading ? (\n        <div className=\"space-y-3\">\n          {[1, 2, 3].map((i) => (\n            <div key={i} className=\"h-16 bg-zinc-900/40 rounded-lg animate-pulse\" />\n          ))}\n        </div>\n      ) : events.length === 0 ? (\n        <div className=\"text-center py-12 space-y-3\">\n          <Shield className=\"w-12 h-12 text-zinc-700 mx-auto\" />\n          <p className=\"text-zinc-500 font-mono text-sm\">No ASM events detected yet.</p>\n          <p className=\"text-xs text-zinc-600\">Events will appear here when SageAI discovers changes to your attack surface.</p>\n        </div>\n      ) : (\n        <div className=\"relative\">\n          {/* Vertical timeline line */}\n          <div className=\"absolute left-4 top-0 bottom-0 w-px bg-zinc-800\" />\n\n          <div className=\"space-y-3\">\n            {events.map((evt) => {\n              const cfg = sevConfig[evt.severity] || sevConfig.info;\n              const Icon = cfg.icon;\n              return (\n                <div key={evt.id} className={`relative pl-10 border-l-2 ${cfg.color} rounded-r-lg p-4`}>\n                  <div className=\"absolute left-2 top-4 w-4 h-4 rounded-full bg-zinc-900 border-2 border-current flex items-center justify-center\">\n                    <Icon className=\"w-2.5 h-2.5\" />\n                  </div>\n                  <div className=\"flex items-start justify-between gap-4\">\n                    <div className=\"min-w-0\">\n                      <p className=\"text-sm font-bold text-white\">{evt.title}</p>\n                      {evt.description && <p className=\"text-xs text-zinc-400 mt-1 line-clamp-2\">{evt.description}</p>}\n                    </div>\n                    <div className=\"flex flex-col items-end gap-1 shrink-0\">\n                      <span className=\"text-[10px] font-bold uppercase tracking-wider\">{evt.severity}</span>\n                      <span className=\"text-[10px] text-zinc-600 font-mono\">\n                        {evt.created_at ? new Date(evt.created_at).toLocaleString() : \"\"}\n                      </span>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\AnalyticsCharts.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\AttackGraph.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":11,"column":88,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":11,"endColumn":91,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[435,438],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[435,438],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":17,"column":52,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":17,"endColumn":55,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[683,686],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[683,686],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":49,"column":29,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":49,"endColumn":32,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1592,1595],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1592,1595],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useEffect, useState, useRef } from \"react\";\nimport dynamic from \"next/dynamic\";\nimport { Card, CardContent } from \"@/components/ui/card\";\n\n// Next.js doesn't support SSR for react-force-graph-2d out of the box\nconst ForceGraph2D = dynamic(() => import(\"react-force-graph-2d\"), { ssr: false });\n\nexport interface GraphData {\n  nodes: { id: string; name: string; val: number; color?: string; type: string; data?: any }[];\n  links: { source: string; target: string }[];\n}\n\nexport function AttackGraph({ data }: { data: GraphData }) {\n  const [dimensions, setDimensions] = useState({ width: 800, height: 400 });\n  const [selectedNode, setSelectedNode] = useState<any>(null);\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    if (containerRef.current) {\n      setDimensions({\n        width: containerRef.current.clientWidth,\n        height: 600, // Fixed height for graph\n      });\n    }\n\n    const handleResize = () => {\n      if (containerRef.current) {\n        setDimensions({\n          width: containerRef.current.clientWidth,\n          height: 600,\n        });\n      }\n    };\n\n    window.addEventListener(\"resize\", handleResize);\n    return () => window.removeEventListener(\"resize\", handleResize);\n  }, []);\n\n  return (\n    <Card className=\"bg-black border-emerald-900/50 overflow-hidden relative\" ref={containerRef}>\n      <CardContent className=\"p-0 relative\">\n        <ForceGraph2D\n          graphData={data}\n          width={dimensions.width}\n          height={dimensions.height}\n          nodeLabel=\"name\"\n          nodeColor={(node: any) => node.color || (node.type === \"vuln\" ? \"#ef4444\" : \"#10b981\")}\n          linkColor={() => \"#064e3b\"}\n          backgroundColor=\"#000000\"\n          nodeRelSize={4}\n          linkDirectionalParticles={2}\n          linkDirectionalParticleSpeed={0.005}\n          onNodeClick={(node) => setSelectedNode(node)}\n        />\n        {selectedNode && selectedNode.data && (\n          <div className=\"absolute top-4 right-4 w-96 bg-black/95 text-emerald-400 border border-emerald-900/50 p-4 rounded-xl text-xs overflow-y-auto max-h-[90%] shadow-[0_0_30px_rgba(6,78,59,0.3)] z-50\">\n            <div className=\"flex justify-between items-center mb-4 pb-2 border-b border-emerald-900/50\">\n              <h3 className=\"font-bold font-mono text-sm text-emerald-300 uppercase truncate pr-4\" title={selectedNode.name}>\n                {selectedNode.name}\n              </h3>\n              <button \n                onClick={() => setSelectedNode(null)} \n                className=\"text-gray-500 hover:text-white transition-colors\"\n              >\n                Γ£ò\n              </button>\n            </div>\n            <pre className=\"whitespace-pre-wrap font-mono leading-relaxed\">\n              {JSON.stringify(selectedNode.data, null, 2)}\n            </pre>\n          </div>\n        )}\n      </CardContent>\n    </Card>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\AuditLog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\AutoFixPanel.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\CommandPalette.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\ComplianceCenter.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'CheckCircle' is defined but never used.","line":4,"column":40,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":51,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"CheckCircle"},"fix":{"range":[86,99],"text":""},"desc":"Remove unused variable \"CheckCircle\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useState } from \"react\";\nimport { FileCheck, Download, Loader2, CheckCircle, Shield } from \"lucide-react\";\nimport axios from \"axios\";\n\nconst frameworks = [\n  { id: \"soc2\", label: \"SOC 2 Type II\", desc: \"Trust services criteria audit\", icon: \"≡ƒöÆ\" },\n  { id: \"pci-dss\", label: \"PCI DSS\", desc: \"Payment card industry standard\", icon: \"≡ƒÆ│\" },\n  { id: \"hipaa\", label: \"HIPAA\", desc: \"Health data privacy compliance\", icon: \"≡ƒÅÑ\" },\n  { id: \"iso27001\", label: \"ISO 27001\", desc: \"Information security management\", icon: \"≡ƒîÉ\" },\n  { id: \"gdpr\", label: \"GDPR\", desc: \"EU data protection regulation\", icon: \"≡ƒç¬≡ƒç║\" },\n  { id: \"nist\", label: \"NIST CSF\", desc: \"Cybersecurity framework\", icon: \"≡ƒÅ¢∩╕Å\" },\n];\n\ninterface ComplianceReport {\n  framework: string;\n  score: number;\n  status: string;\n  controls_passed: number;\n  controls_total: number;\n  gaps: string[];\n}\n\nexport function ComplianceCenter() {\n  const [selected, setSelected] = useState<string | null>(null);\n  const [report, setReport] = useState<ComplianceReport | null>(null);\n  const [loading, setLoading] = useState(false);\n\n  const generateReport = async (frameworkId: string) => {\n    setSelected(frameworkId);\n    setLoading(true);\n    setReport(null);\n    try {\n      const { data } = await axios.get(`/api/compliance?framework=${frameworkId}`);\n      setReport(data);\n    } catch {\n      setReport({\n        framework: frameworkId,\n        score: 0,\n        status: \"unavailable\",\n        controls_passed: 0,\n        controls_total: 0,\n        gaps: [\"Run scans to generate compliance data.\"],\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const scoreColor = (score: number) =>\n    score >= 80 ? \"text-emerald-400\" : score >= 50 ? \"text-amber-400\" : \"text-red-400\";\n\n  const scoreBarColor = (score: number) =>\n    score >= 80 ? \"bg-emerald-500\" : score >= 50 ? \"bg-amber-500\" : \"bg-red-500\";\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center gap-2 mb-2\">\n        <FileCheck className=\"w-5 h-5 text-emerald-400\" />\n        <h3 className=\"text-sm font-bold text-white\">Compliance Report Generator</h3>\n      </div>\n\n      {/* Framework Grid */}\n      <div className=\"grid grid-cols-2 md:grid-cols-3 gap-3\">\n        {frameworks.map((fw) => (\n          <button\n            key={fw.id}\n            onClick={() => generateReport(fw.id)}\n            className={`text-left p-4 rounded-xl border transition-all ${\n              selected === fw.id\n                ? \"bg-emerald-900/30 border-emerald-500/50\"\n                : \"bg-zinc-900/60 border-zinc-800 hover:border-zinc-700\"\n            }`}\n          >\n            <span className=\"text-2xl mb-2 block\">{fw.icon}</span>\n            <p className=\"text-sm font-bold text-white\">{fw.label}</p>\n            <p className=\"text-xs text-zinc-500 mt-0.5\">{fw.desc}</p>\n          </button>\n        ))}\n      </div>\n\n      {/* Loading */}\n      {loading && (\n        <div className=\"flex justify-center py-8\">\n          <Loader2 className=\"w-6 h-6 text-emerald-400 animate-spin\" />\n        </div>\n      )}\n\n      {/* Report Result */}\n      {report && !loading && (\n        <div className=\"bg-zinc-900/60 border border-emerald-900/30 rounded-xl p-6 space-y-5\">\n          <div className=\"flex items-center justify-between\">\n            <h4 className=\"text-sm font-bold text-white flex items-center gap-2\">\n              <Shield className=\"w-4 h-4 text-emerald-400\" />\n              {frameworks.find((f) => f.id === report.framework)?.label} Assessment\n            </h4>\n            <span className={`text-3xl font-black ${scoreColor(report.score)}`}>\n              {report.score}<span className=\"text-lg text-zinc-500\">%</span>\n            </span>\n          </div>\n\n          {/* Score Bar */}\n          <div className=\"w-full bg-zinc-800 rounded-full h-2.5\">\n\n            <div\n              className={`h-2.5 rounded-full transition-all duration-500 ${scoreBarColor(report.score)}`}\n              style={{ width: `${report.score}%` }}\n            />\n          </div>\n\n          {/* Controls */}\n          <div className=\"flex gap-6\">\n            <div>\n              <p className=\"text-xs text-zinc-500 font-mono uppercase\">Controls Passed</p>\n              <p className=\"text-xl font-black text-emerald-400\">\n                {report.controls_passed}<span className=\"text-zinc-500 text-sm\">/{report.controls_total}</span>\n              </p>\n            </div>\n            <div>\n              <p className=\"text-xs text-zinc-500 font-mono uppercase\">Status</p>\n              <p className={`text-sm font-bold capitalize ${\n                report.status === \"compliant\" ? \"text-emerald-400\" : \"text-amber-400\"\n              }`}>\n                {report.status}\n              </p>\n            </div>\n          </div>\n\n          {/* Gaps */}\n          {report.gaps.length > 0 && (\n            <div>\n              <p className=\"text-xs text-zinc-500 font-mono uppercase mb-2\">Identified Gaps</p>\n              <div className=\"space-y-1.5\">\n                {report.gaps.map((gap, i) => (\n                  <div key={i} className=\"flex items-start gap-2 text-sm text-amber-300/80 bg-amber-950/20 border border-amber-900/20 rounded-lg px-3 py-2\">\n                    <span className=\"text-amber-500 mt-0.5\">ΓÇó</span> {gap}\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          <button className=\"flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-lg transition-colors text-sm\">\n            <Download className=\"w-4 h-4\" /> Export Compliance Report\n          </button>\n        </div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\DashboardOverview.tsx","messages":[{"ruleId":"@next/next/no-html-link-for-pages","severity":2,"message":"Do not use an `<a>` element to navigate to `/history/`. Use `<Link />` from `next/link` instead. See: https://nextjs.org/docs/messages/no-html-link-for-pages","line":93,"column":9,"nodeType":"JSXOpeningElement","endLine":93,"endColumn":137}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useState, useEffect } from \"react\";\nimport { BarChart3, Shield, AlertTriangle, Zap } from \"lucide-react\";\nimport axios from \"axios\";\nimport { AnalyticsCharts } from \"./AnalyticsCharts\";\n\ninterface ScanSummary {\n  id: string;\n  target: string;\n  status: string;\n  risk_score?: number;\n  created_at?: string;\n}\n\nexport function DashboardOverview() {\n  const [recentScans, setRecentScans] = useState<ScanSummary[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    axios\n      .get(\"/api/scans\")\n      .then((r) => setRecentScans(r.data.slice(0, 5)))\n      .catch(() => {})\n      .finally(() => setLoading(false));\n  }, []);\n\n  const totalScans = recentScans.length;\n  const avgRisk = totalScans\n    ? Math.round(recentScans.reduce((s, r) => s + (r.risk_score || 0), 0) / totalScans)\n    : 0;\n  const criticalCount = recentScans.filter((s) => (s.risk_score || 0) >= 70).length;\n\n  const cards = [\n    { label: \"Total Scans\", value: totalScans, icon: BarChart3, color: \"text-emerald-400\" },\n    { label: \"Avg Risk Score\", value: avgRisk, icon: Shield, color: avgRisk >= 70 ? \"text-red-400\" : avgRisk >= 40 ? \"text-amber-400\" : \"text-emerald-400\" },\n    { label: \"Critical Targets\", value: criticalCount, icon: AlertTriangle, color: \"text-red-400\" },\n  ];\n\n  return (\n    <div className=\"space-y-8\">\n      {/* Stat Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n        {cards.map((c) => (\n          <div key={c.label} className=\"bg-zinc-900/60 border border-emerald-900/30 rounded-xl p-6 flex items-center gap-4\">\n            <c.icon className={`w-8 h-8 ${c.color}`} />\n            <div>\n              <p className=\"text-3xl font-black text-white\">{loading ? \"ΓÇö\" : c.value}</p>\n              <p className=\"text-sm text-zinc-400 font-mono\">{c.label}</p>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Analytics Charts */}\n      <AnalyticsCharts />\n\n      {/* Recent Scans */}\n      <div>\n        <h3 className=\"text-lg font-bold text-emerald-400 mb-4 flex items-center gap-2\">\n          <Zap className=\"w-4 h-4\" /> Recent Scans\n        </h3>\n        {loading ? (\n          <p className=\"text-zinc-500 font-mono text-sm animate-pulse\">Loading scan history...</p>\n        ) : recentScans.length === 0 ? (\n          <p className=\"text-zinc-500 font-mono text-sm\">No scans yet. Run your first scan from the homepage.</p>\n        ) : (\n          <div className=\"space-y-2\">\n            {recentScans.map((scan) => (\n              <div key={scan.id} className=\"flex items-center justify-between bg-zinc-900/40 border border-zinc-800 rounded-lg px-4 py-3\">\n                <div>\n                  <p className=\"text-white font-mono text-sm\">{scan.target}</p>\n                  <p className=\"text-xs text-zinc-500\">{scan.created_at ? new Date(scan.created_at).toLocaleString() : \"ΓÇö\"}</p>\n                </div>\n                <div className=\"flex items-center gap-3\">\n                  <span className={`text-xs font-bold px-2 py-1 rounded ${\n                    scan.status === \"completed\" ? \"bg-emerald-900/50 text-emerald-400\" : \"bg-zinc-800 text-zinc-400\"\n                  }`}>\n                    {scan.status}\n                  </span>\n                  {scan.risk_score !== undefined && (\n                    <span className={`text-sm font-black ${\n                      scan.risk_score >= 70 ? \"text-red-400\" : scan.risk_score >= 40 ? \"text-amber-400\" : \"text-emerald-400\"\n                    }`}>\n                      {scan.risk_score}\n                    </span>\n                  )}\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n        <a href=\"/history\" className=\"text-xs text-emerald-500/60 hover:text-emerald-400 font-mono mt-3 inline-block transition-colors\">\n          View all scans ΓåÆ\n        </a>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\DataExport.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\EmailReportSettings.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\components\\ExportButton.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"