rEmail} />\n                <NavNotifications />\n                <span className=\"text-xs font-mono text-zinc-500 hidden md:inline\">{userEmail}</span>\n                <a href=\"/api/auth/logout\" className=\"text-xs font-mono text-red-400/70 hover:text-red-300 px-3 py-1.5 rounded-md hover:bg-red-900/20 transition-all\">\n                  Sign Out\n                </a>\n              </>\n            ) : (\n              <Link href=\"/login\" className=\"text-sm font-mono bg-emerald-600/20 text-emerald-400 px-4 py-2 rounded-md hover:bg-emerald-600/30 transition border border-emerald-500/30\">\n                Sign In\n              </Link>\n            )}\n          </div>\n        </header>\n        <main className=\"flex-1 w-full relative\">\n          {children}\n        </main>\n        {userEmail && (\n          <>\n            <CommandPalette />\n            <OnboardingWizard />\n          </>\n        )}\n      </body>\n    </html>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\app\\loading.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\pc\\Downloads\\SageAI\\sage-web\\src\\app\\login\\page.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":39,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":39,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1161,1164],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1161,1164],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErr